# Copie este arquivo para ".env.local" e preencha os valores reais.
# NUNCA suba o ".env.local" para o Git (ele já está no .gitignore).

# Token da API v2 do Reportei. Gere um token NOVO e exclusivo para este
# dashboard em app.reportei.com -> Configuracoes da empresa -> API Reportei.
# NAO reutilize nem apague o token "MCP OAuth - Claude" que existe nessa
# mesma tela - ele sustenta outra integracao.
REPORTEI_TOKEN=

# Senha da tela de acesso do dashboard. Escolha algo que a equipe consiga
# digitar e compartilhar com seguranca.
DASHBOARD_PASSWORD=
